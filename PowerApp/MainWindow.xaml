<Window x:Class="PowerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PowerApp"
        mc:Ignorable="d"
        Title="Power Requests Monitor"
        Height="1024" Width="860"
        MinHeight="500" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E24"
        Foreground="#ECECF1"
        FontFamily="Segoe UI, Segoe UI Variable Display">

    <Window.Resources>
        <!-- Modern ScrollViewer Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Category Card Border -->
        <Style x:Key="CategoryBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#262630"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#353545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Request Item Border -->
        <Style x:Key="RequestItemStyle" TargetType="Border">
            <Setter Property="Background" Value="#2E2E3C"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#444458"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Status & Header -->
            <RowDefinition Height="Auto"/> <!-- Admin Notice Banner -->
            <RowDefinition Height="Auto"/> <!-- Quick Category Filters -->
            <RowDefinition Height="*"/>    <!-- Category & Request List -->
            <RowDefinition Height="Auto"/> <!-- Bottom Actions Bar -->
        </Grid.RowDefinitions>

        <!-- Header & Status Card -->
        <Border Grid.Row="0" Background="#262630" CornerRadius="10" BorderBrush="#38384A" BorderThickness="1" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Dot -->
                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Ellipse x:Name="StatusGlowEllipse" Width="26" Height="26" Fill="#3322C55E"/>
                    <Ellipse x:Name="StatusDotEllipse" Width="14" Height="14" Fill="#22C55E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Status Text -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatusTitleText" Text="No Wake Requests Active" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        <Border x:Name="ActiveCountBadge" Background="#E53935" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="ActiveCountBadgeText" Text="2 Active" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="StatusSubtitleText" Text="System can enter sleep mode normally" FontSize="12" Foreground="#9E9EAA" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Quick Refresh / Timestamp -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="LastUpdatedText" Text="Updated: Just now" FontSize="11" Foreground="#858598" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="ElevationStatusText" Text="Administrator" FontSize="11" Foreground="#4CAF50" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Admin Elevation Warning Banner (Visible only if not elevated) -->
        <Border x:Name="AdminBanner" Grid.Row="1" Background="#3D2E14" BorderBrush="#856404" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Administrator Privileges Required" FontWeight="SemiBold" FontSize="13" Foreground="#FFD54F"/>
                    <TextBlock Text="Querying wake requests requires elevation. Please restart as administrator." FontSize="11" Foreground="#FFE082"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Try Demo Data" Click="OnTryDemoClicked"
                            Background="#5C4518" Foreground="#FFD54F" Padding="10,6"
                            BorderThickness="0" Margin="0,0,8,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Restart as Admin" Click="OnRestartAsAdminClicked"
                            Background="#F59E0B" Foreground="#000000" FontWeight="SemiBold" Padding="12,6"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Quick Category Summary Badges -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12">
            <StackPanel x:Name="CategoryChipsPanel" Orientation="Horizontal"/>
        </ScrollViewer>

        <!-- Main Categories & Requests List -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="CategoriesPanel"/>
        </ScrollViewer>

        <!-- Bottom Toolbar -->
        <Border Grid.Row="4" Background="#262630" CornerRadius="8" BorderBrush="#38384A" BorderThickness="1" Padding="10,8" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 Refresh" Click="OnRefreshClicked"
                            Background="#3E3E50" Foreground="#FFFFFF" Padding="12,6" BorderThickness="0"
                            Margin="0,0,8,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="📋 Copy (powercfg /requests)" Click="OnCopyOutputClicked"
                            Background="#3E3E50" Foreground="#FFFFFF" Padding="12,6" BorderThickness="0"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <CheckBox x:Name="AutoRefreshCheckBox" Content="Auto-refresh" IsChecked="True"
                              Foreground="#CCCCCC" VerticalAlignment="Center" Checked="OnAutoRefreshChanged" Unchecked="OnAutoRefreshChanged"/>
                    <ComboBox x:Name="RefreshIntervalComboBox" Margin="8,0,0,0" Width="72"
                              SelectionChanged="OnIntervalSelectionChanged">
                        <ComboBoxItem Content="3s"/>
                        <ComboBoxItem Content="5s" IsSelected="True"/>
                        <ComboBoxItem Content="10s"/>
                        <ComboBoxItem Content="30s"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Hide to Tray" Click="OnHideToTrayClicked"
                            Background="#353545" Foreground="#B0B0C0" Padding="12,6" BorderThickness="0"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
